# URL pública da API PHP do VOXEL PACS
DELIVERY_HUB_API_URL=https://server.voxelpacs.com.br

# Gere com: openssl rand -hex 32
# Deve ser idêntico ao VOXEL_REPORT_DELIVERY_WORKER_TOKEN no .env do HostGator.
VOXEL_REPORT_DELIVERY_WORKER_TOKEN=CHANGE_ME_GENERATE_64_HEX_CHARACTERS

# Identidade auditável deste processo no VPS
DELIVERY_HUB_WORKER_ID=report-delivery-vps-01
DELIVERY_HUB_POLL_SECONDS=5
DELIVERY_HUB_LOG_LEVEL=INFO

# Segurança: deve permanecer true até a homologação formal de um destino.
DELIVERY_HUB_DRY_RUN=true
# Trava adicional do C-STORE. Só habilitar após C-ECHO, C-STORE de teste e aceite do PACS cliente.
DELIVERY_HUB_DICOM_PDF_ENABLED=false
