# Instalar como /etc/voxelpacs-backup/common.env com modo 0600 e proprietário root:root.
# Preencher por meio do cofre de segredos; este arquivo de exemplo não contém credenciais reais.
RESTIC_REPOSITORY_BASE=s3:https://<endpoint-privado>/<bucket-voxelpacs-backup>/tenants
RESTIC_CACHE_DIR=/var/cache/voxelpacs/restic
RESTIC_PASSWORD_FILE=/etc/voxelpacs-backup/restic-password
AWS_ACCESS_KEY_ID=<referencia-do-cofre>
AWS_SECRET_ACCESS_KEY=<referencia-do-cofre>
AWS_DEFAULT_REGION=hel1
