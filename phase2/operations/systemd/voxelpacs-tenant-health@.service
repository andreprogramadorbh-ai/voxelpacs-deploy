[Unit]
Description=VOXEL PACS healthcheck técnico do tenant %i
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/voxelpacs-tenant-healthcheck %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# O coletor Prometheus é opcional; sem ele o script registra métricas no journal.
ReadWritePaths=-/var/lib/node_exporter/textfile_collector
