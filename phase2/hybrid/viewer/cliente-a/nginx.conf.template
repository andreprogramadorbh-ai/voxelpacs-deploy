# Cliente A — virtual host OHIF exclusivo.
# Pré-requisitos: DNS A/AAAA para cliente-a.view.voxelpacs.com.br, certificado
# TLS emitido e endpoint interno de autorização implantado na API privada.

server {
    listen 80;
    server_name cliente-a.view.voxelpacs.com.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name cliente-a.view.voxelpacs.com.br;

    ssl_certificate     /etc/letsencrypt/live/cliente-a.view.voxelpacs.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cliente-a.view.voxelpacs.com.br/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Usa $uri (sem query-string) para impedir que StudyInstanceUIDs sejam
    # registrados no access log do viewer.
    access_log /opt/voxelpacs/logs/cliente-a-viewer-access.log voxel_tenant;
    error_log  /opt/voxelpacs/logs/cliente-a-viewer-error.log warn;

    location = /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # A API aceita exclusivamente subrequisições oriundas do host privado do
    # viewer, com cookie HttpOnly, token vigente, tenant, célula e origem iguais.
    location = /_voxel_viewer_auth {
        internal;
        proxy_pass https://10.0.0.2/internal/viewer-auth/cliente-a;
        proxy_ssl_server_name on;
        proxy_ssl_name server.voxelpacs.com.br;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 4;
        # Cadeia pública específica da API privada, instalada pelo provisionador.
        proxy_ssl_trusted_certificate /etc/ssl/certs/voxelpacs-api-chain.pem;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Voxel-Viewer-Origin https://cliente-a.view.voxelpacs.com.br;
        proxy_set_header Host server.voxelpacs.com.br;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # O app-config muda por tenant e não pode permanecer no cache do PWA.
    location = /app-config.js {
        auth_request /_voxel_viewer_auth;
        error_page 401 = @viewer_unauthorized;
        error_page 403 = @viewer_forbidden;
        error_page 503 = @viewer_unavailable;
        proxy_pass http://127.0.0.1:3001/app-config.js;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "no-store, max-age=0" always;
    }

    # Caminhos históricos são normalizados sem dispensar a autenticação no
    # destino. A rota DICOMweb explícita evita datasource nulo no OHIF v3.12.
    location = /viewer {
        auth_request /_voxel_viewer_auth;
        error_page 401 = @viewer_unauthorized;
        error_page 403 = @viewer_forbidden;
        error_page 503 = @viewer_unavailable;
        return 302 /viewer/dicomweb$is_args$args;
    }

    location /dicom-web/ {
        auth_request /_voxel_viewer_auth;
        error_page 401 = @viewer_unauthorized;
        error_page 403 = @viewer_forbidden;
        error_page 503 = @viewer_unavailable;

        proxy_pass http://10.0.0.3:8044/dicom-web/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic __ORTHANC_CLIENT_A_API_BASIC__";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 2G;
    }

    location / {
        auth_request /_voxel_viewer_auth;
        error_page 401 = @viewer_unauthorized;
        error_page 403 = @viewer_forbidden;
        error_page 503 = @viewer_unavailable;

        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }

    location @viewer_unauthorized { return 401; }
    location @viewer_forbidden { return 403; }
    location @viewer_unavailable { return 503; }
}
