# Copie para /etc/voxelpacs/tenants/<tenant>/tenant.env com permissão 0600.
# Gere as senhas no host. Nunca adicione valores reais a este arquivo de exemplo.
COMPOSE_PROJECT=voxelpacs-__TENANT_KEY__
POSTGRES_DB=orthanc___TENANT_KEY_SQL__
POSTGRES_USER=orthanc___TENANT_KEY_SQL__
POSTGRES_PASSWORD=__GENERATED_ON_HOST__
ORTHANC_USER=__TENANT_KEY___api
ORTHANC_PASSWORD=__GENERATED_ON_HOST__
TENANT_DATA_ROOT=/var/lib/orthanc/tenants/__TENANT_KEY__
TENANT_CONFIG_ROOT=/etc/voxelpacs/tenants/__TENANT_KEY__
HOST_PRIVATE_IP=10.0.0.3
DICOM_PORT=4245
DICOMWEB_PORT=8045
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_CPU_LIMIT=0.50
POSTGRES_MEMORY_LIMIT=512M
ORTHANC_CPU_LIMIT=1.00
ORTHANC_MEMORY_LIMIT=1024M
TZ=America/Sao_Paulo
