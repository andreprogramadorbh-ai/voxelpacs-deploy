{
  // ==========================================================================
  // VOXEL PACS — /etc/orthanc/orthanc.json
  // Orthanc 1.12.2 — instalação nativa (systemd)
  // Plugins: dicom-web, postgresql-index, worklists, housekeeper
  //
  // FASE 1 (Segurança): hardening aplicado em 2026-07-30
  // FASE 2 (PostgreSQL): já ativo via /etc/orthanc/postgresql.json
  //   EnableIndex=true, EnableStorage=false
  //   Host=127.0.0.1, DB=orthanc, User=orthanc
  //
  // Storage: /var/lib/orthanc/db-v6 (38GB, 15.746 instâncias, 202 estudos)
  // Fase 3 (Gateway — PENDENTE): DicomCheckCalledAet/CallingAet
  // ==========================================================================

  // ── Identidade ─────────────────────────────────────────────────────────────
  "Name": "VOXEL PACS",
  "AETitle": "VOXELSRVPACS",

  // ── Storage ────────────────────────────────────────────────────────────────
  "StorageDirectory": "/var/lib/orthanc/db-v6",
  "IndexDirectory": "/var/lib/orthanc/db-v6",

  // ── Portas ─────────────────────────────────────────────────────────────────
  "HttpPort": 8042,
  "DicomPort": 4242,

  // ── Acesso remoto e autenticação ───────────────────────────────────────────
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,

  // ── Plugins ────────────────────────────────────────────────────────────────
  "Plugins": ["/usr/share/orthanc/plugins"],

  // ── Performance ────────────────────────────────────────────────────────────
  "HttpThreadsCount": 50,
  "KeepAlive": true,
  "TcpNoDelay": true,

  // ── CORS (necessário para OHIF) ────────────────────────────────────────────
  "HttpHeaders": {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Headers": "Authorization, Content-Type, Accept",
    "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS"
  },

  // ── DICOM ──────────────────────────────────────────────────────────────────
  "DicomAet": "VOXELSRVPACS",
  "DicomPort": 4242,
  "DicomScuTimeout": 10,
  "DicomServerEnabled": true,
  "UnknownSopClassAccepted": true,

  // ATENÇÃO — Fase 3 (Gateway — PENDENTE):
  // Habilitar após configurar gateway DICOM e cadastrar todos os modalities.
  "DicomCheckCalledAet": false,
  "DicomCheckCallingAet": false,

  // ── Modalities cadastradas ─────────────────────────────────────────────────
  "DicomModalities": {
    "pacsFIR": {
      "AET": "pacsFIR",
      "Host": "177.136.206.165",
      "Port": 2104,
      "Manufacturer": "Generic",
      "AllowEcho": true,
      "AllowFind": true,
      "AllowGet": true,
      "AllowMove": true,
      "AllowStore": true
    }
  },

  // ── Segurança — Fase 1 ─────────────────────────────────────────────────────
  // Limitar resultados de busca para evitar DoS e sobrecarga de memória
  "LimitFindResults": 100,
  "LimitFindInstances": 100,

  // Desabilitar interfaces e recursos não utilizados em produção
  "WebDavEnabled": false,
  "OrthancExplorerEnabled": false,
  "ExecuteLuaEnabled": false,
  "RestApiWriteToFileSystemEnabled": false,

  // Otimização: não acessar storage em buscas (evita I/O desnecessário)
  "StorageAccessOnFind": "Never",

  // Não persistir jobs entre reinicializações (reduz I/O e complexidade)
  "SaveJobs": false,

  // Não sobrescrever instâncias DICOM duplicadas (proteção de dados)
  "OverwriteInstances": false,

  // ── Logs ───────────────────────────────────────────────────────────────────
  "HttpDescribeErrors": true,
  "HttpVerbose": false,
  "LogLevel": "default",

  // ── SSL (gerenciado pelo Nginx no host) ────────────────────────────────────
  "SslEnabled": false
}
